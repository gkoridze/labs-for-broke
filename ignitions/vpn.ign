{"ignition":{"version":"3.5.0"},"storage":{"files":[{"path":"/etc/sysctl.d/90-ipv4-ip-forward.conf","contents":{"compression":"","source":"data:,net.ipv4.ip_forward%20%3D%201%0A"},"mode":420}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=nat rule\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStartPre=/usr/sbin/iptables -A FORWARD -i wg0 -j ACCEPT\nExecStart=/usr/sbin/iptables -t nat -A POSTROUTING -o enX0 -j MASQUERADE\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"nat-rule.service"}]}}
